# 开发期默认使用 mock；真实冒烟时改为 sensenova
GEN_PROVIDER_MODE=mock
QWEN_IMAGE_API_KEY=
QWEN_IMAGE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
QWEN_IMAGE_MODEL=qwen-image-2.1-turbo
SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_MODEL=sensenova-u1.5-lite
SENSENOVA_TIMEOUT_SECONDS=120
SENSENOVA_MAX_RETRIES=2
SENSENOVA_RETRY_BACKOFF_SECONDS=1
TASK_DB_URL=sqlite:///../data/app.db
STORAGE_ROOT=../data/storage
TEMPLATE_LIBRARY_PATH=../data/templates.json
UPLOAD_MAX_MB=10

# V7 开发期邮箱验证码与角色白名单（生产环境禁止 dev_fixed）
AUTH_MODE=dev_fixed
AUTH_DEV_CODE=000000
ADMIN_EMAILS=
OPERATOR_EMAILS=
SESSION_TTL_SECONDS=604800
LOGIN_CODE_TTL_SECONDS=600
LOGIN_CODE_MAX_ATTEMPTS=5
SESSION_COOKIE_SECURE=0
